// ============================================================
// REGRAS DO FIRESTORE — Rastreamento de Cargas + Controle de Frota + Controle de CIOT
// Os três painéis usam o mesmo projeto Firebase.
// Console Firebase > Firestore Database > Regras > apagar tudo > colar > Publicar
// ============================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rastreamento de Cargas
    match /notas/{id}               { allow read: if true; allow write: if request.auth != null; }
    match /historico/{id}           { allow read: if true; allow write: if request.auth != null; }
    match /resumo_diario/{id}       { allow read: if true; allow write: if request.auth != null; }

    // Controle de Frota
    match /frota/{id}               { allow read: if true; allow write: if request.auth != null; }
    match /frota_historico/{id}     { allow read: if true; allow write: if request.auth != null; }
    match /frota_afastamentos/{id}  { allow read: if true; allow write: if request.auth != null; }
    match /frota_colaboradores/{id} { allow read: if true; allow write: if request.auth != null; }
    match /frota_checklists/{id}    { allow read: if true; allow write: if request.auth != null; }

    // Controle de CIOT — PRIVADO: só o(s) e-mail(s) da lista lê(em) e grava(m).
    // Troque SEU_EMAIL@EXEMPLO.COM pelo e-mail criado em Authentication > Users (pode pôr mais de um, separados por vírgula).
    function ciotLiberado() {
      return request.auth != null
        && request.auth.token.email in ['SEU_EMAIL@EXEMPLO.COM'];
    }
    match /ciot_motoristas/{id}     { allow read, write: if ciotLiberado(); }
    match /ciot_registros/{id}      { allow read, write: if ciotLiberado(); }
    match /ciot_historico/{id}      { allow read, write: if ciotLiberado(); }
  }
}
