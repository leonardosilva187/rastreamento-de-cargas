// ============================================================
// REGRAS DO FIRESTORE — Rastreamento de Cargas
// Console Firebase > Firestore Database > Regras > colar > Publicar
// ============================================================

// ---------- PASSO 1 (agora): usar ESTAS regras ----------
// Mantém o funcionamento atual (PIN + login anônimo) e libera a nova
// coleção "resumo_diario" (série histórica do passivo).
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notas/{id}          { allow read: if true; allow write: if request.auth != null; }
    match /historico/{id}      { allow read: if true; allow write: if request.auth != null; }
    match /resumo_diario/{id}  { allow read: if true; allow write: if request.auth != null; }
  }
}

